-- select

select 
	c.endereco_wallet,
	c.rede_blockchain,
	c.saldo_usd,
	i.nome,
	i.cpf
from investidores i
left join carteira c on i.id = c.id
where c.status = 'Ativa', 'Em Analise';

select 
	co.nome_exchange,
	t.valor_pago,
from corretoras c
left join transacoes_cripto t on c.id = t.id

-- views

create view vw_painel_carteiras as
select 
	c.endereco_wallet,
	c.rede_blockchain,
	c.saldo_usd,
	i.nome,
	i.cpf
from investidores i
left join carteira c on i.id = c.id;

create view vw_investimento_total_carteiras as
select 
	c.endereco_wallet,
	c.saldo_usd,
	t.quantidade,
	t.valor_pago
from carteira c
left join transacoes_cripto t on c.id = t.id
